{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-agent.local/schemas/review_queue.schema.json",
  "title": "review-queue.json file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cards"
  ],
